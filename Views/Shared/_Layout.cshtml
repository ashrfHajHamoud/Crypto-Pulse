<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CryptoPulse – Live Dashboard</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>

<nav class="navbar navbar-expand-lg" id="mainNav">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">
            <i class="bi bi-graph-up-arrow text-warning me-2"></i>
            <span class="fw-bold">CryptoPulse</span>
            <span class="badge bg-success ms-2 small">LIVE</span>
        </a>
        <div class="ms-auto d-flex align-items-center gap-3">
            <span id="connectionStatus" class="status-badge status-connecting">
                <span class="status-dot"></span> Connecting…
            </span>
            <button id="themeToggle" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-moon-stars-fill"></i>
            </button>
        </div>
    </div>
</nav>

<div class="container-fluid px-4 py-3">
    @RenderBody()
</div>

<!-- Bootstrap 5 JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>

@RenderSection("Scripts", required: false)
</body>
</html>
