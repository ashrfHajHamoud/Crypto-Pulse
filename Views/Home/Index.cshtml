@{
    ViewData["Title"] = "CryptoPulse Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- ═══════════════════════ SYMBOL SELECTOR ═══════════════════════ -->
<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <span class="text-muted small me-1">Select Coin:</span>
            @foreach (var sym in new[] { "BTC", "ETH", "SOL", "DOGE" })
            {
                <button class="btn btn-crypto @(sym == "BTC" ? "active" : "")"
                        data-symbol="@sym"
                        onclick="switchSymbol('@sym', this)">
                    @sym
                </button>
            }
            <div class="ms-auto">
                <button id="btnAllMode" class="btn btn-outline-info btn-sm" onclick="switchToAll()">
                    <i class="bi bi-grid-3x2-gap-fill me-1"></i>All Coins Mode
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════ ANOMALY ALERT ═══════════════════════ -->
<div id="anomalyAlert" class="alert alert-danger alert-dismissible d-none mb-3 anomaly-flash" role="alert">
    <strong><i class="bi bi-exclamation-triangle-fill me-2"></i><span id="anomalyText"></span></strong>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>

<!-- ═══════════════════════ STAT CARDS ═══════════════════════ -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-label">Current Price</div>
            <div class="stat-value" id="statPrice">—</div>
            <div class="stat-sub" id="statChange">—</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-label">24h High</div>
            <div class="stat-value text-success" id="statHigh">—</div>
            <div class="stat-sub">Highest today</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-label">24h Low</div>
            <div class="stat-value text-danger" id="statLow">—</div>
            <div class="stat-sub">Lowest today</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-card">
            <div class="stat-label">Volume</div>
            <div class="stat-value text-info" id="statVolume">—</div>
            <div class="stat-sub">Total traded</div>
        </div>
    </div>
</div>

<!-- ═══════════════════════ CHART + LOG ═══════════════════════ -->
<div class="row g-3">

    <!-- Chart -->
    <div class="col-lg-8">
        <div class="panel-card">
            <div class="panel-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-bar-chart-line me-2"></i>Live Price Chart – <span id="chartTitle">BTC</span></span>
                <button class="btn btn-sm btn-outline-secondary" onclick="clearChart()">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Clear
                </button>
            </div>
            <div class="panel-body chart-container">
                <canvas id="priceChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Event Log -->
    <div class="col-lg-4">
        <div class="panel-card h-100 d-flex flex-column">
            <div class="panel-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-clock-history me-2"></i>Event Log</span>
                <button class="btn btn-sm btn-outline-secondary" onclick="clearLog()">
                    <i class="bi bi-trash me-1"></i>Clear
                </button>
            </div>
            <div class="panel-body flex-grow-1 p-0">
                <ul id="eventLog" class="event-log list-unstyled mb-0"></ul>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════ ALL-COINS TABLE ═══════════════════════ -->
<div class="row g-3 mt-1" id="allCoinsSection" style="display:none!important">
    <div class="col-12">
        <div class="panel-card">
            <div class="panel-header">
                <i class="bi bi-table me-2"></i>All Coins – Live Prices
            </div>
            <div class="panel-body p-0">
                <table class="table table-dark table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>Symbol</th>
                            <th>Price</th>
                            <th>Change</th>
                            <th>Change %</th>
                            <th>24h High</th>
                            <th>24h Low</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="allCoinsBody"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Reconnect overlay -->
<div id="reconnectOverlay" class="reconnect-overlay d-none">
    <div class="reconnect-box">
        <div class="spinner-border text-warning mb-3"></div>
        <div class="fw-bold">Connection lost. Reconnecting…</div>
        <small class="text-muted" id="reconnectCountdown"></small>
    </div>
</div>

@section Scripts {
    <script src="/js/stream.js"></script>
}
